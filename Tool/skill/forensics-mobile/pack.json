{
  "schema": "seep.pack/1",
  "id": "forensics-mobile",
  "l1": "目标是内存镜像/pcap/磁盘/EVTX/注册表、IPA/Mach-O/Keychain，或 Unity 资源只读取证时打开。",
  "routes": [
    {
      "label": "取证/iOS·macOS/游戏客户端",
      "must": [
        "(?i)(?:\\bvolatility3?\\b|\\brekall\\b|\\bmem\\.raw\\b|\\bmemory\\s*dump\\b|内存镜像|内存取证|崩溃转储)",
        "(?i)(?:\\bpcap(?:ng)?\\b|\\btshark\\b|\\bwireshark\\b|流量分析|网络取证|会话重组|dns\\s*隧道)",
        "(?i)(?:\\bsleuthkit\\b|\\bmmls\\b|\\bfls\\b|\\bicat\\b|\\bmactime\\b|磁盘镜像|分区镜像|文件系统取证|\\$mft\\b)",
        "(?i)(?:\\bevtx\\b|\\bwinevt\\b|事件日志|注册表\\s*(?:hive|取证|导出)|\\breg\\s+save\\b|\\bamcache\\b|\\bprefetch\\b|\\bshellbag|\\bjumplist|\\busbstor\\b)",
        "(?i)(?:\\b(?:ios|ipados|iphone|ipad|ipa|macos|mach-o|keychain|codesign|entitlements)\\b|embedded\\.mobileprovision)",
        "(?i)^(?!.*(?:\\bandroid\\b|\\.apk\\b|\\bwindows\\b|\\bpc\\b|gameassembly|\\.exe\\b|\\.dll\\b)).*(?:\\bil2cpp\\b|\\bunityframework\\b|\\bassetbundle\\b|\\bunityfs\\b|\\bglobal-metadata(?:\\.dat)?\\b|unity\\s*(?:资源|客户端)|游戏客户端)",
        "(?i)(?:\\bassetbundle\\b|\\bunityfs\\b|unity\\s*资源)",
        "(?i)(?:浏览器取证|history\\s*sqlite|\\bhindsight\\b|places\\.sqlite|\\bvisit_time\\b)",
        "(?i)(?:数字取证|取证分析|取证调查|主机取证|移动取证|证据链|时间线重建.{0,12}(?:证据|取证))",
        "(?i)(?:镜像|dump|快照|备份).{0,10}(?:里|里面).{0,6}(?:发生过|干了什么|发生了什么|做过什么|有什么痕迹)|(?:发生过什么|干了什么|动过|翻过|看过).{0,10}(?:镜像|电脑|手机|机器)",
        "(?i)(?:被人(?:动|翻|看|碰|拷|登录)过|谁(?:动|翻|碰)过|时间线|什么时候(?:登录|插上|拷走)|痕迹|现场)",
        "(?i)(?:流量包|抓的包|这个包|数据包|日志|记录).{0,10}(?:看看|分析|还原|查一下|在干什么|什么情况|能说明什么)|(?:查一下|看看|分析|还原|放一下).{0,6}(?:流量包|抓的包|数据包|日志|记录)",
        "(?i)^(?!.*(?:\\bandroid\\b|\\.apk\\b|\\bwindows\\b|\\bpc\\b|gameassembly|\\.exe\\b|\\.dll\\b)).*(?:^|[^A-Za-z])il2cpp(?![A-Za-z])"
      ],
      "priority": 180
    }
  ],
  "stages": [
    "0-analysis",
    "1-ask",
    "2-dyn",
    "3-patch",
    "4-verify"
  ],
  "tools": [
    "seep_pcap_extract",
    "seep_mem_strings",
    "seep_r2_cmd"
  ],
  "cases": [
    "forensics07"
  ],
  "case_roles": {
    "witness": [
      "forensics07"
    ],
    "depth_gate": [
      "forensics01",
      "forensics02",
      "forensics03",
      "forensics04",
      "forensics06",
      "forensics07"
    ]
  },
  "depth_contract": {    "skill": "forensics-mobile",    "board": "forensics",    "matrix": "forensics-mobile-matrix.json",    "case_globs": [      "forensics*"    ],    "ext_scripts": [      "`forensics-check`（S4 已删：壳，真身在 forensics-mobile/scripts/）"    ]  },
  "witness": {
    "cmd": "python Tool/scripts/case_state.py verify --case Tool/cases/forensics07",
    "expect": "exit0 + facts>=3 + artifacts/MANIFEST.sha256",
    "budget_s": 180
  },
  "evidence_contract": {
    "required_fields": [
      "claim",
      "confidence",
      "authority",
      "evidence"
    ],
    "authority_allow": [
      "shipped-artifact",
      "controlled-replay",
      "external-service"
    ],
    "pass_forbids_confidence": [
      "inferred",
      "unknown"
    ]
  },
  "limitations": [
    "iOS 取证只做文件级，不做全盘解密",
    "游戏客户端只读 Mono/IL2CPP 资源，不改运行时"
  ],
  "invalidation": [
    "需要写操作或改机器状态",
    "目标数据已不可复现（无镜像/无 pcap）"
  ],
  "project_lifecycle": {
    "entry": "Tool/scripts/project_state.py",
    "manager": "Tool/scripts/manager_state.py",
    "handoff": "Tool/scripts/project_state.py",
    "resume": "Tool/scripts/project_state.py",
    "version": "Tool/scripts/project_state.py",
    "run": "Tool/scripts/project_state.py",
    "migration": "Tool/scripts/project_state.py"
  },
  "input_contract": {
    "types": ["memory image", "pcap/pcapng", "disk image", "EVTX", "registry hive", "IPA/Mach-O", "Keychain or Unity resource"],
    "sample_completeness": {
      "required": ["original evidence image or capture", "acquisition metadata and hash", "timezone/context for timeline claims"],
      "missing_means": "缺镜像、pcap、备份、密钥或原始元数据只是输入要求，不代表取证结论或解密能力已完成。"
    },
    "environment": {
      "required": ["read-only evidence workspace", "known timezone and acquisition context", "authorized credentials or keys only when the evidence requires them"],
      "missing_means": "缺样本、账号、设备、密钥或网络上下文时只能标记缺证据，不能补推行为。"
    }
  },
  "failure_contract": {
    "criteria": "Tool/skill/forensics-mobile/references/02-failure-criteria.md",
    "block": "Tool/config/blockers.json",
    "reroute": {
      "manager": "Tool/scripts/manager_state.py",
      "skill": "Tool/skill/forensics-mobile/SKILL.md"
    }
  },
  "version_contract": {
    "version": "Tool/scripts/project_state.py",
    "run": "Tool/scripts/project_state.py",
    "migration": "Tool/scripts/project_state.py",
    "variant": "Tool/skill/forensics-mobile/SKILL.md",
    "incremental": "Tool/skill/forensics-mobile/SKILL.md"
  },
  "extension_contract": {
    "entry": "Tool/scripts/skill-import.py",
    "docs": "Tool/docs/EXTEND.md",
    "pack": "Tool/skill/forensics-mobile/pack.json",
    "parent_skill": "Tool/skill/softseep/SKILL.md"
  },
  "witness_tool": {
    "cmd": "Tool/skill/forensics-mobile/scripts/witness.py",
    "why": "真跑 forensics-check.py 分析 Tool/cases/forensics07/target/bgp-4byte-asn.pcap：断言 type/format=pcap、meta.packet_count>0、UTC timeline 与 integrity.sha256，证明 pcap 取证初检真的产出结果"
  }
}
