{
  "schemaVersion": 2,
  "_comment": "工具运行清单：每个工具声明『它能被 AI 控制的通道』，按优先级从高到低排列。Agent 永远取第一个可用的，不硬性指定某工具。",
  "_优先级原则": [
    "1. mcp-stdio / mcp-http：工具自带可编程接口 —— Agent 直连，无需 GUI，最优先",
    "2. cli / headless：命令行或 headless 模式能完成同样操作 —— 次优（无窗口、可脚本化、可重复）",
    "3. gui：只能靠 GUI 才能控制（GUI 内插件提供 MCP，或必须点菜单）—— 再次，且必须由 Agent 自己启动",
    "4. manual：确实需要人看屏幕（首次许可、崩溃恢复弹窗）—— 最后手段，只在此处才回报用户"
  ],
  "_铁律": "只要 headless / CLI 能把事做完，就绝不启动 GUI。GUI 不是『更好』，是『更麻烦』：要焦点、要弹窗、要人盯。",
  "_用法": "powershell -File Tool/scripts/tool-run.ps1 -Tool <id> [-Target <样本>] [-Mode <mode-id>] [-ListModes]",
  "tools": {
    "x64dbg": {
      "prefer": [
        "mcp-http"
      ],
      "modes": [
        {
          "id": "mcp-http",
          "kind": "mcp-http",
          "why": "x64dbg 没有 headless 调试通道；其 MCP 由 GUI 进程内插件提供（唯一可控入口），因此这一档本身就是『GUI 内 MCP』",
          "start": {
            "toolId": "x64dbg",
            "args": [
              "{target}"
            ]
          },
          "ready": {
            "type": "tcp",
            "port": 9094,
            "timeoutSec": 90
          },
          "endpoint": {
            "url": "http://127.0.0.1:9094/mcp",
            "transport": "http",
            "tools": 80
          },
          "auth": {
            "header": "Authorization",
            "fromFile": "%AUTH_JSON%#AuthToken",
            "authJson": "{exeDir}/mcp_config.json"
          }
        }
      ],
      "probe": {
        "names": [
          "x64dbg",
          "x64dbg.exe"
        ],
        "envVars": [
          "SEEP_X64DBG_PATH"
        ],
        "globs": [
          "{home}/.seep/tools/**/x64dbg.exe",
          "{localappdata}/Programs/x64dbg/release/x64/x64dbg.exe",
          "{localappdata}/Microsoft/WinGet/Packages/**/x64dbg.exe",
          "{programfiles}/x64dbg/release/x64/x64dbg.exe",
          "{programfilesx86}/x64dbg/release/x64/x64dbg.exe",
          "{drive}/*/x64dbg/release/x64/x64dbg.exe",
          "{drive}/*/*/x64dbg/release/x64/x64dbg.exe",
          "{drive}/*/*/*/x64dbg.exe"
        ]
      },
      "verify": {
        "kind": "pe",
        "expectMachine": [
          "AMD64"
        ],
        "informSiblings": [
          "Qt5Core.dll",
          "x64dbg.dll"
        ],
        "timeoutSec": 20,
        "why": "x64dbg.exe 是 GUI 二进制，没有 --version；自检=解析 PE 头（MZ/PE/machine=AMD64）+ 报告依赖 DLL 是否在位，绝不把『文件存在』当就绪"
      },
      "install": {
        "requiresNetwork": true,
        "requiresAdmin": false,
        "pathHint": "探测已覆盖 {home}/.seep/tools/** 与各盘 */x64dbg/release/x64 —— 解压到这些位置后无需改 PATH",
        "catalog": "Tool/config/tool-install.json",
        "primary": {
          "via": "shared",
          "cmd": "python Tool/scripts/tool-acquire.py --tool x64dbg --install --json",
          "note": "Windows 调试器（支持 winget 与绿色快照双途径）"
        }
      }
    },
    "x32dbg": {
      "prefer": [
        "mcp-http"
      ],
      "modes": [
        {
          "id": "mcp-http",
          "kind": "mcp-http",
          "why": "同 x64dbg；与它共用 9094，二者只开其一",
          "start": {
            "toolId": "x32dbg",
            "args": [
              "{target}"
            ]
          },
          "ready": {
            "type": "tcp",
            "port": 9094,
            "timeoutSec": 90
          },
          "endpoint": {
            "url": "http://127.0.0.1:9094/mcp",
            "transport": "http",
            "tools": 80
          },
          "auth": {
            "header": "Authorization",
            "fromFile": "%AUTH_JSON%#AuthToken",
            "authJson": "{exeDir}/mcp_config.json"
          }
        }
      ]
    },
    "ida": {
      "prefer": [
        "headless-cli",
        "gui-mcp"
      ],
      "modes": [
        {
          "id": "headless-cli",
          "kind": "cli",
          "why": "IDA 自带 headless：idat 批处理 + IDAPython 脚本，功能等价于 GUI 分析，且无窗口、可并行、可重复 —— 优先用这条",
          "command": "\"{exeDir}/{exeName}\" -A -S\"{script}\" \"{target}\"",
          "argv": [
            "-A",
            "-S{script}",
            "{target}"
          ],
          "scriptKind": "file",
          "fallbackExe": [
            "idat64.exe",
            "idat.exe"
          ],
          "note": "通过 -Script 提供实际存在的 IDAPython 脚本；-A 自动分析，-S 执行脚本。",
          "toolId": "ida"
        },
        {
          "id": "headless-mcp",
          "kind": "mcp-sse",
          "why": "可选 idalib-mcp 服务；启动方式、端点和依赖需与实际安装版本匹配，独立握手后才报告连接可用。",
          "start": {
            "toolId": "ida",
            "exeCandidates": [
              "idalib-mcp.exe"
            ],
            "args": [
              "{target}",
              "--port",
              "8745"
            ]
          },
          "ready": {
            "type": "tcp",
            "port": 8745,
            "timeoutSec": 300
          },
          "endpoint": {
            "url": "http://127.0.0.1:8745/sse",
            "transport": "sse"
          }
        },
        {
          "id": "gui-mcp",
          "kind": "gui",
          "why": "GUI 内 mcp-plugin 提供 13337；插件不自启，必须 Ctrl+Alt+M —— 最后才用",
          "start": {
            "toolId": "ida",
            "exeCandidates": [
              "ida64.exe",
              "ida.exe"
            ],
            "args": [
              "{target}"
            ]
          },
          "postLaunchKeys": "^%m",
          "ready": {
            "type": "tcp",
            "port": 13337,
            "timeoutSec": 120
          },
          "endpoint": {
            "url": "http://127.0.0.1:13337/mcp",
            "transport": "http"
          }
        }
      ],
      "probe": {
        "names": [
          "idat64",
          "idat64.exe",
          "idat",
          "idat.exe"
        ],
        "envVars": [
          "SEEP_IDA_PATH"
        ],
        "globs": [
          "{home}/.seep/tools/**/idat64.exe",
          "{home}/.seep/tools/**/idat.exe",
          "{programfiles}/IDA*/idat64.exe",
          "{programfiles}/IDA*/idat.exe",
          "{programfilesx86}/IDA*/idat64.exe",
          "{programfilesx86}/IDA*/idat.exe",
          "{drive}/*/IDA*/idat64.exe",
          "{drive}/*/IDA*/idat.exe",
          "{drive}/*/*/IDA*/idat64.exe",
          "{drive}/*/*/IDA*/idat.exe"
        ],
        "note": "只认 headless 的 idat64/idat —— GUI 的 ida.exe 不能批处理，找到也不算这条通道就绪"
      },
      "verify": {
        "kind": "pe",
        "expectMachine": [
          "AMD64",
          "I386"
        ],
        "informSiblings": [
          "ida.dll",
          "idalib.dll"
        ],
        "timeoutSec": 20,
        "why": "idat 没有 --version（跑起来会要 license、还会拉起分析）；自检=解析 PE 头 + 报告 ida.dll/idalib.dll 是否同在目录，绝不把『文件存在』当就绪"
      },
      "install": {
        "requiresNetwork": false,
        "requiresAdmin": false,
        "requiresInput": true,
        "pathHint": "探测已覆盖各盘 */IDA*/idat*.exe 与 %ProgramFiles%\\IDA*，装在常规位置就不用登记",
        "catalog": "Tool/config/tool-install.json",
        "primary": {
          "via": "shared",
          "cmd": "python Tool/scripts/tool-acquire.py --tool ida --install --json",
          "note": "需已有 IDA 商业授权和实际安装；自动发现后选择可用通道，指定 SEEP_IDA_PATH 时填真实程序路径。"
        }
      }
    },
    "ghidra": {
      "prefer": [
        "cli-headless",
        "gui"
      ],
      "modes": [
        {
          "id": "cli-headless",
          "kind": "cli",
          "why": "Ghidra analyzeHeadless 可独立运行分析脚本，需安装 Ghidra 和兼容 Java；seep_r2_decompile 当前使用 r2。",
          "command": "\"{exeDir}/analyzeHeadless.bat\" \"{workDir}/ghidra_proj\" seep_proj -import \"{target}\" -postScript DumpDecomp.java -deleteProject",
          "argv": [
            "{workDir}/ghidra_proj",
            "seep_proj",
            "-import",
            "{target}",
            "-scriptPath",
            "{scriptDir}",
            "-postScript",
            "{scriptName}",
            "-deleteProject"
          ],
          "scriptKind": "file",
          "fallbackExe": [
            "analyzeHeadless.bat",
            "analyzeHeadless"
          ],
          "note": "具体脚本及其目录需按任务提供；此命令模板不代表 Ghidra MCP 或自动反编译链已连接。",
          "toolId": "ghidra"
        },
        {
          "id": "gui",
          "kind": "gui",
          "why": "仅人工会话需要可视化时",
          "start": {
            "toolId": "ghidra",
            "exeCandidates": [
              "ghidraRun.bat",
              "ghidraRun"
            ]
          },
          "ready": {
            "type": "tcp",
            "port": 8192,
            "timeoutSec": 240
          }
        }
      ]
    },
    "frida": {
      "prefer": [
        "cli"
      ],
      "modes": [
        {
          "id": "cli",
          "kind": "cli",
          "toolId": "frida",
          "command": "\"{exeDir}/{exeName}\" --version",
          "argv": [
            "--version"
          ],
          "why": "脚本化注入：比调试器更不容易被反调试识别；attach 用 -p、spawn 用 -f。是强反调试目标的首选仪器",
          "fallbackExe": [
            "frida"
          ]
        }
      ]
    },
    "r2": {
      "prefer": [
        "cli"
      ],
      "modes": [
        {
          "id": "cli",
          "kind": "cli",
          "toolId": "r2",
          "command": "\"{exeDir}/{exeName}\" -q -c \"{script}\" \"{target}\"",
          "argv": [
            "-q",
            "-c",
            "{script}",
            "{target}"
          ],
          "scriptKind": "command",
          "fallbackExe": [
            "r2.bat",
            "r2.exe",
            "radare2.exe"
          ],
          "why": "r2 -q -c '<cmd>' 单条命令即返回，全程 headless；只取信息（头/段/字符串/符号）就用同目录 rabin2，不必交互",
          "note": "{script} 换成 r2 命令串（如 'pdg @ main'）；整条路径由 probe 决定"
        }
      ],
      "probe": {
        "names": [
          "rabin2",
          "rabin2.exe",
          "r2.exe",
          "r2"
        ],
        "envVars": [
          "SEEP_R2_PATH",
          "SEEP_RABIN2_PATH"
        ],
        "repoPaths": [
          "Tool/mcp/Tool/safe/radare2/bin/rabin2.exe",
          "Tool/mcp/Tool/safe/radare2/bin/radare2.exe"
        ],
        "globs": [
          "{home}/.seep/tools/**/rabin2.exe",
          "{home}/radare2/bin/rabin2.exe",
          "{programfiles}/radare2/bin/rabin2.exe",
          "{drive}/*/radare2*/bin/rabin2.exe",
          "{drive}/*/*/radare2*/bin/rabin2.exe"
        ],
        "note": "按环境、PATH、仓库副本及工具目录发现；目录存在不保证当前平台可运行。"
      },
      "verify": {
        "kind": "exec",
        "exe": "rabin2.exe",
        "args": [
          "-v"
        ],
        "expect": "(?i)\\brabin2\\s+\\d+\\.\\d+",
        "allowRc": [
          0
        ],
        "timeoutSec": 20,
        "identityProbe": "rabin2",
        "why": "不只看有没有输出：expect 必须打出 'rabin2 <版本>'（改名的 radare2.exe 冒充 rabin2 会在此处露馅）；再加 tool_identity 的 -I 行为探针"
      },
      "install": {
        "requiresNetwork": true,
        "requiresAdmin": false,
        "pathHint": "解压到 %USERPROFILE%\\.seep\\tools 下后探测器自动命中；设 SEEP_R2_PATH 指向 rabin2.exe 也可",
        "catalog": "Tool/config/tool-install.json",
        "primary": {
          "via": "shared",
          "cmd": "python Tool/scripts/tool-acquire.py --tool r2 --install --json",
          "note": "统一由 tool-install.json 选择当前平台的白名单方法；安装后重新发现和验证。"
        }
      }
    },
    "rabin2": {
      "prefer": [
        "cli"
      ],
      "modes": [
        {
          "id": "cli",
          "kind": "cli",
          "toolId": "rabin2",
          "command": "\"{exeDir}/{exeName}\" -I \"{target}\"",
          "argv": [
            "-I",
            "{target}"
          ],
          "fallbackExe": [
            "rabin2.exe",
            "rabin2"
          ],
          "why": "rabin2 -I/-z 单次调用即退出，只读元数据/字符串，不起交互外壳；比 r2 -c 更小、更不容易被脚本卡住",
          "note": "{target} 换成样本路径；要同时看安全缓解用 -Ij，要看字符串用 -z/-zz。写操作（-w 等）不在本通道范围"
        }
      ],
      "probe": {
        "names": [
          "rabin2",
          "rabin2.exe"
        ],
        "envVars": [
          "SEEP_RABIN2_PATH"
        ],
        "repoPaths": [
          "Tool/mcp/Tool/safe/radare2/bin/rabin2.exe",
          "Tool/mcp/Tool/safe/radare2/bin/rabin2"
        ],
        "globs": [
          "{home}/.seep/tools/**/bin/rabin2",
          "{home}/.seep/tools/**/bin/rabin2.exe",
          "{home}/radare2/bin/rabin2",
          "{home}/radare2/bin/rabin2.exe",
          "{programfiles}/radare2/bin/rabin2.exe",
          "{drive}/*/radare2*/bin/rabin2.exe",
          "{drive}/*/*/radare2*/bin/rabin2.exe",
          "/usr/bin/rabin2",
          "/usr/local/bin/rabin2",
          "/opt/radare2/bin/rabin2"
        ],
        "note": "**独立于 r2 的条目**：r2 条目里的 rabin2 名字只服务 r2 的探活，不能当 rabin2 已登记。仓库自带副本（Tool/mcp/Tool/safe/radare2/bin）与 PATH 都能命中"
      },
      "verify": {
        "kind": "exec",
        "exe": "rabin2",
        "args": [
          "-v"
        ],
        "expect": "(?i)\\brabin2\\s+\\d+\\.\\d+",
        "allowRc": [
          0
        ],
        "timeoutSec": 20,
        "identityProbe": "rabin2",
        "why": "只跑无目标的 L0 版本探针（rabin2 -v 取版本/头版本，不加载任何目标文件）；expect 必须打出 'rabin2 <版本>'，改名的 radare2.exe 会在此处露馅（另由 tool_identity 的 -I 行为探针二次确认）"
      },
      "install": {
        "requiresNetwork": true,
        "requiresAdmin": false,
        "pathHint": "解压/装好后探测器自动命中（PATH、~/.seep/tools、radare2 目录）；也可设 SEEP_RABIN2_PATH 直接指向 rabin2 可执行文件",
        "catalog": "Tool/config/tool-install.json",
        "primary": {
          "via": "shared",
          "cmd": "python Tool/scripts/tool-acquire.py --tool rabin2 --install --json",
          "note": "统一由 tool-install.json 选择当前平台的白名单方法；安装后重新发现和验证。"
        }
      }
    },
    "java": {
      "prefer": [
        "cli"
      ],
      "modes": [
        {
          "id": "cli",
          "kind": "cli",
          "toolId": "java",
          "command": "\"{exeDir}/{exeName}\" -version",
          "argv": [
            "-version"
          ],
          "fallbackExe": [
            "java.exe",
            "java"
          ],
          "why": "java 是运行时而不是逆向工具：这里只声明『无目标版本探针』通道；实际跑 jadx/apktool 由各自条目负责",
          "note": "本通道故意只跑 -version：不接受任意 jar（那是执行目标代码，不属于工具探活）"
        }
      ],
      "probe": {
        "names": [
          "java",
          "java.exe"
        ],
        "envVars": [
          "SEEP_JAVA_PATH"
        ],
        "repoPaths": [],
        "globs": [
          "{home}/.seep/tools/**/bin/java",
          "{home}/.seep/tools/**/bin/java.exe",
          "{home}/.jdks/*/bin/java",
          "{programfiles}/Java/*/bin/java.exe",
          "{programfiles}/Eclipse Adoptium/*/bin/java.exe",
          "{programfiles}/Microsoft/*/bin/java.exe",
          "{programfilesx86}/Java/*/bin/java.exe",
          "{localappdata}/Programs/Eclipse Adoptium/*/bin/java.exe",
          "{drive}/*/Android Studio/jbr/bin/java.exe",
          "{drive}/*/*/jbr/bin/java.exe",
          "/usr/bin/java",
          "/usr/lib/jvm/*/bin/java",
          "/opt/homebrew/opt/openjdk/bin/java",
          "/usr/local/opt/openjdk/bin/java"
        ],
        "note": "JAVA_HOME 是**目录**不是可执行文件，清单里不能当路径用；server 侧 _find_java() 会把 JAVA_HOME 展开成 bin/java，探测器这边靠 PATH / 常见 JDK 目录 / SEEP_JAVA_PATH"
      },
      "verify": {
        "kind": "exec",
        "exe": "java",
        "args": [
          "-version"
        ],
        "expect": "(?i)(?:java|openjdk)\\s+version\\s+\"?\\d+\\.\\d+",
        "allowRc": [
          0
        ],
        "timeoutSec": 20,
        "why": "只跑无目标的 L0 版本探针（java -version 不加载任何类/无论证文件）；输出形如 openjdk version \"21.0.12\" 或 java version \"1.8.0_301\"。绝不用 java -jar 做自检——那是执行任意代码"
      },
      "install": {
        "requiresNetwork": true,
        "requiresAdmin": false,
        "pathHint": "装好后 java 在 PATH 上即被探测到；只想指定一份 JDK 就设 JAVA_HOME=<JDK 根目录>（server 侧认它）或 SEEP_JAVA_PATH=<java 可执行文件>",
        "catalog": "Tool/config/tool-install.json",
        "primary": {
          "via": "shared",
          "cmd": "python Tool/scripts/tool-acquire.py --tool java --install --json",
          "note": "统一由 tool-install.json 选择当前平台的白名单方法；安装后重新发现和验证。"
        }
      }
    },
    "jadx": {
      "prefer": [
        "cli"
      ],
      "modes": [
        {
          "id": "cli",
          "kind": "cli",
          "toolId": "jadx",
          "command": "\"{exeDir}/{exeName}\" -d \"{workDir}/jadx-out\" \"{target}\"",
          "argv": [
            "-d",
            "{workDir}/jadx-out",
            "{target}"
          ],
          "fallbackExe": [
            "jadx.bat",
            "jadx"
          ],
          "why": "jadx CLI 全量反编译（含资源/清单），无窗口、可重复；要 GUI 才用 jadx-gui",
          "note": "输出落 {workDir}/jadx-out，失败时加 --show-bad-code 看原因"
        }
      ],
      "probe": {
        "names": [
          "jadx",
          "jadx.bat",
          "jadx.cmd"
        ],
        "envVars": [
          "SEEP_JADX_PATH"
        ],
        "repoPaths": [
          "Tool/mcp/Tool/safe/jadx/bin/jadx.bat",
          "Tool/mcp/Tool/safe/jadx/bin/jadx"
        ],
        "globs": [
          "{home}/.seep/tools/**/bin/jadx.bat",
          "{localappdata}/Microsoft/WinGet/Packages/**/bin/jadx.bat",
          "{programfiles}/jadx/bin/jadx.bat",
          "{drive}/*/jadx*/bin/jadx.bat",
          "{drive}/*/*/jadx*/bin/jadx.bat"
        ]
      },
      "verify": {
        "kind": "exec",
        "exe": "jadx.bat",
        "args": [
          "--version"
        ],
        "expect": "^\\d+\\.\\d+",
        "allowRc": [
          0
        ],
        "timeoutSec": 20,
        "identityProbe": "jadx",
        "why": "--version 必须打出纯版本号（如 1.5.6）；.bat 走 cmd /c，否则 CreateProcess 会静默失败"
      },
      "install": {
        "requiresNetwork": true,
        "requiresAdmin": false,
        "pathHint": "探测器已覆盖 {home}/.seep/tools/**/bin/jadx.bat 与各盘 */jadx*/bin/jadx.bat",
        "catalog": "Tool/config/tool-install.json",
        "primary": {
          "via": "shared",
          "cmd": "python Tool/scripts/tool-acquire.py --tool jadx --install --json",
          "note": "JADX Java/DEX 反编译（工作台已默认内置，支持外部一键重装）"
        }
      }
    },
    "apktool": {
      "prefer": [
        "cli"
      ],
      "modes": [
        {
          "id": "cli",
          "kind": "cli",
          "toolId": "apktool",
          "command": "\"{exeDir}/{exeName}\" d -f \"{target}\" -o \"{workDir}/apktool-out\"",
          "argv": [
            "d",
            "-f",
            "{target}",
            "-o",
            "{workDir}/apktool-out"
          ],
          "fallbackExe": [
            "apktool.bat",
            "apktool"
          ],
          "why": "apktool d/b 完全 headless：解包拿 smali/资源/清单，回包用 b",
          "note": "需要 Java（java -jar）；回包：apktool b <目录> -o out.apk"
        }
      ],
      "probe": {
        "names": [
          "apktool",
          "apktool.bat",
          "apktool.cmd"
        ],
        "envVars": [
          "SEEP_APKTOOL_PATH"
        ],
        "repoPaths": [
          "Tool/mcp/Tool/safe/apktool/apktool.bat"
        ],
        "globs": [
          "{home}/.seep/tools/**/apktool.bat",
          "{localappdata}/apktool/apktool.bat",
          "{drive}/*/apktool*/apktool.bat",
          "{drive}/*/apktool/apktool.bat",
          "{drive}/*/*/apktool/apktool.bat"
        ]
      },
      "verify": {
        "kind": "exec",
        "exe": "apktool.bat",
        "args": [
          "--version"
        ],
        "expect": "^\\d+\\.\\d+",
        "allowRc": [
          0
        ],
        "timeoutSec": 20,
        "identityProbe": "apktool",
        "why": "--version 必须打出纯版本号（如 2.11.0）；机器缺 Java 时这里会失败 —— 那正是要看见的 FOUND_NO_VERIFY"
      },
      "install": {
        "requiresNetwork": true,
        "requiresAdmin": false,
        "requires": [
          "java"
        ],
        "pathHint": "落 %USERPROFILE%\\.seep\\tools\\apktool 后自动命中；设 SEEP_APKTOOL_PATH 指向 apktool.bat 也可",
        "catalog": "Tool/config/tool-install.json",
        "primary": {
          "via": "shared",
          "cmd": "python Tool/scripts/tool-acquire.py --tool apktool --install --json",
          "note": "按官方 https://apktool.org/docs/install/ 获取当前平台的包装脚本和 apktool.jar，安装 Java；放在用户工具目录并登记路径，再跑版本和任务验证。当前没有自动 JAR 安装方法。"
        }
      }
    },
    "tshark": {
      "prefer": [
        "cli"
      ],
      "modes": [
        {
          "id": "cli",
          "kind": "cli",
          "toolId": "tshark",
          "command": "\"{exeDir}/{exeName}\" -r \"{target}\" -Y \"http\" -T fields -e frame.number -e ip.src -e ip.dst",
          "argv": [
            "-r",
            "{target}",
            "-Y",
            "http",
            "-T",
            "fields",
            "-e",
            "frame.number",
            "-e",
            "ip.src",
            "-e",
            "ip.dst"
          ],
          "fallbackExe": [
            "tshark.exe",
            "tshark"
          ],
          "why": "tshark -r/-Y/-T json 完全 headless：读 pcap 做协议分析，不用 Wireshark GUI",
          "note": "抓包需要 Npcap（安装 Wireshark 时勾）；只读 pcap 不需要"
        }
      ],
      "probe": {
        "names": [
          "tshark",
          "tshark.exe"
        ],
        "envVars": [
          "SEEP_TSHARK_PATH"
        ],
        "repoPaths": [],
        "globs": [
          "{programfiles}/Wireshark/tshark.exe",
          "{localappdata}/Microsoft/WinGet/Packages/**/tshark.exe",
          "{programfilesx86}/Wireshark/tshark.exe",
          "{drive}/Wireshark/tshark.exe",
          "{drive}/*/Wireshark/tshark.exe",
          "{drive}/*/Wireshark*/tshark.exe",
          "{drive}/*/*/Wireshark/tshark.exe"
        ]
      },
      "verify": {
        "kind": "exec",
        "exe": "tshark.exe",
        "args": [
          "-v"
        ],
        "expect": "(?i)tshark\\s*\\(wireshark\\)\\s*\\d",
        "allowRc": [
          0
        ],
        "timeoutSec": 20,
        "why": "-v 首行必须是 'TShark (Wireshark) <版本>'：只有 Wireshark 装好且 DLL 齐全时才会打出这行"
      },
      "install": {
        "requiresNetwork": true,
        "requiresAdmin": true,
        "pathHint": "默认装到 %ProgramFiles%\\Wireshark（探测器已覆盖），无需改 PATH",
        "catalog": "Tool/config/tool-install.json",
        "primary": {
          "via": "shared",
          "cmd": "python Tool/scripts/tool-acquire.py --tool tshark --install --json",
          "note": "Wireshark/TShark 抓包分析（支持 winget 自动安装）"
        }
      }
    }
  },
  "_判定原则（新增工具时照这个顺序定 kind）": {
    "1_mcp-stdio": "工具自带 stdio MCP → pi 会话启动时自己拉起，用户不用管（seep / js-reverse / playwright）",
    "2_cli": "有 CLI 或 headless 能做同样的事 → 绝不启动 GUI（r2 / jadx / apktool / idat / analyzeHeadless / tshark / nmap）",
    "3_mcp-http|mcp-sse": "控制面在宿主进程内（调试钩子 / 断点 / 注入 / 内存读写）→ 由 Agent 用 tool-run 按需自启，单实例，用完 StopDebug 或退出",
    "4_gui": "只有 GUI 能操作、且没有 MCP → 最后手段；仍由 Agent 自启，并必须在 why 里写明「为什么没有 headless 等价物」",
    "5_manual": "首次许可协议 / 崩溃恢复弹窗这类必须人看屏幕的 → 才找用户"
  },
  "_何时不该启动": "任务不需要该工具的控制面时就不启动。例：纯静态反编译用 idat 就够，别开 IDA GUI；读内存快照用 pe-sieve 就够，别挂 x64dbg。判据是「这次任务需不需要在目标进程里下钩子/断点」。",
  "_度在哪里（三条硬约束）": [
    "按需自启：任务需要才起，不做开机常驻（GUI 宿主占资源、抢焦点、可能干扰目标反调试判定）",
    "单实例：同一宿主只开一个（x64dbg/x32dbg 共用 9094，多开必抢端口）",
    "用完即关：调试收尾 StopDebug；GUI 会话结束就退出，别留着占端口"
  ]
}
