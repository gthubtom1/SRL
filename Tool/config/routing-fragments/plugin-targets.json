{
  "origin": "plugin-targets",
  "routes": {
    "R25": {
      "label": "插件/扩展/Mod 逆向",
      "skill": "plugin-targets/SKILL.md",
      "keywords": [
        {
          "must": "(?i)\\b(crx|xpi|vsix|asar|bytenode|jsc)\\b|v8\\s*字节码",
          "note": "包型锚定：crx/xpi/vsix/asar。判据=入口+权限/扩展点+数据流+最小可改单元"
        },
        {
          "mustAll": [
            "(?i)(浏览器|chrome|chromium|edge|firefox)\\s*(扩展|插件|extension|addon)",
            "(?i)(扩展|插件|extension|addon|crx|xpi|manifest\\.json)"
          ],
          "note": "浏览器扩展：必须同时出现浏览器/宿主与扩展/插件语境，避免抢普通网页词"
        },
        {
          "mustAll": [
            "(?i)\\b(vscode|vs code|jetbrains|intellij|cursor|ide)\\b",
            "(?i)(插件|扩展|extension|plugin\\.xml|vsix|activationevents|扩展点)"
          ],
          "note": "IDE 插件：宿主名 + 插件/扩展点语境"
        },
        {
          "mustAll": [
            "(?i)\\b(electron|asar|preload|ipcmain|ipcrenderer|contextbridge)\\b",
            "(?i)(插件|扩展|app\\.asar|主进程|preload|asar|ipc)"
          ],
          "note": "Electron：主进程/preload/asar 语境，不与普通 Node 项目抢词"
        },
        {
          "must": "(?i)\\b(bepinex|melonloader|harmonyos|assembly-csharp|global-metadata)\\b",
          "note": "Unity Mod / IL2CPP / BepInEx 强锚点"
        },
        {
          "mustAll": [
            "(?i)(unity|游戏|game)\\b",
            "(?i)(\\bmod\\b|插件|加载器|bepinex|melonloader)"
          ],
          "note": "游戏 Mod：unity/game 与 mod/加载器组合"
        },
        {
          "must": "(?i)\\b(nativemessaging|connectnative|sendnativemessage)\\b|NativeMessagingHosts",
          "note": "浏览器 native host 桥"
        },
        {
          "mustAll": [
            "(?i)(输入法|\\bime\\b|obs-studio|streamdeck|注入法|原生插件)",
            "(?i)(插件|扩展|加载|driver|内核|采集)"
          ],
          "note": "输入法/驱动/媒体管线：必须同时出现插件/加载/服务语境"
        },
        {
          "mustAll": [
            "(?i)(插件|扩展)",
            "(?i)(逆向|分析|权限|manifest|入口|service worker|content script|扩展点)"
          ],
          "note": "通用插件逆向：插件/扩展 + 分析/权限/入口语境；不匹配 scaffold/lockfile、src/xxx.dll、zipalign、bios"
        }
      ],
      "priority_hint": {
        "after": "R24"
      }
    }
  }
}
