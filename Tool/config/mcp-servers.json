{
  "schemaVersion": 1,
  "_comment": "安装时要合并进 <agent-dir>/mcp.json 的服务清单。**新增 MCP 只加一条**，install-pi.ps1 与 merge_agent_config.py 都读这里，不用改代码。",
  "_占位符": {
    "{ROOT_POSIX}": "仓库根的 POSIX 路径（由安装器在运行时替换，如 <你的仓库>/Seep-Reverse-Lab）",
    "{ROOT_WIN}": "仓库根的 Windows 路径（同上）"
  },
  "_字段": {
    "onlyIfMissing": "true = 用户已有同名条目时不覆盖（用于带用户凭据的条目，如 playwright token）",
    "lifecycle": "lazy = 用到才连；eager = 会话启动即连"
  },
  "servers": {
    "seep": {
      "command": "python",
      "args": [
        "{ROOT_POSIX}/Tool/mcp/seep_mcp_server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "transport": "stdio"
    },
    "js-reverse": {
      "command": "npx",
      "args": [
        "-y",
        "js-reverse-mcp"
      ],
      "transport": "stdio",
      "lifecycle": "lazy"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--extension"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "<YOUR_PLAYWRIGHT_TOKEN>"
      },
      "transport": "stdio",
      "lifecycle": "lazy",
      "onlyIfMissing": true
    }
  },
  "_可选条目示例": {
    "x64dbg": {
      "url": "http://127.0.0.1:9094/mcp",
      "headers": {
        "Authorization": "!python -c \"import json,os;c=os.path.join(os.environ.get('X64DBG_DIR',''),'mcp_config.json');print('Bearer '+json.load(open(c,encoding='utf-8'))['AuthToken'])\""
      },
      "transport": "http",
      "lifecycle": "lazy",
      "_note": "X64DBG_DIR 指向 x64dbg 安装目录；换机器只改环境变量，不用改这条配置。"
    }
  }
}
