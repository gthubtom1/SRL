    "capa":        { "method": "pip",     "pkg": "flare-capa",   "verify": "capa",  "note": "能力识别" },
    "frida":       { "method": "pip",     "pkg": "frida-tools",  "verify": "frida", "note": "动态插桩" },
    "binwalk":     { "method": "pip",     "pkg": "binwalk",      "verify": "binwalk", "note": "固件/嵌入解包" },
    "unblob":      { "method": "pip",     "pkg": "unblob",       "verify": "unblob", "note": "解包（需编译环境）" },
    "yara":        { "method": "pip",     "pkg": "yara-python",  "verify": "",      "note": "YARA 规则引擎（库）" },
    "pyinstxtractor": { "method": "pip",  "pkg": "pyinstxtractor","verify": "",     "note": "PyInstaller 解包" },
    "diec":        { "method": "manual",  "url": "https://github.com/horsicq/Detect-It-Easy/releases", "verify": "diec", "note": "Detect It Easy 判壳（下便携版放 D:\\Tools）" },
    "x64dbg":      { "method": "winget",  "pkg": "x64dbg.x64dbg", "verify": "x64dbg", "note": "Windows 调试器" },
    "cdb":         { "method": "winget",  "pkg": "Microsoft.WinDbg", "verify": "cdb", "note": "命令行调试器" },
    "nmap":        { "method": "winget",  "pkg": "Insecure.Nmap", "verify": "nmap", "note": "端口/服务扫描" },
    "sqlmap":      { "method": "pip",     "pkg": "sqlmap",       "verify": "sqlmap", "note": "SQL 注入检测" },
    "dirsearch":   { "method": "pip",     "pkg": "dirsearch",    "verify": "dirsearch", "note": "目录爆破" },
    "httpx":       { "method": "pip",     "pkg": "httpx",        "verify": "httpx", "note": "HTTP 探测（注意与 python httpx 同名）" },
