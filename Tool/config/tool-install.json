    "mitmproxy":   { "method": "pip",     "pkg": "mitmproxy",    "verify": "mitmdump", "note": "代理抓包" },
    "curl_cffi":   { "method": "pip",     "pkg": "curl-cffi",    "verify": "", "note": "TLS 指纹伪装（http_replay 用）" },
    "pefile":      { "method": "pip",     "pkg": "pefile",       "verify": "", "note": "PE 解析（packer_detect/pe_resources 用）" },
    "zstandard":   { "method": "pip",     "pkg": "zstandard",    "verify": "", "note": "zstd 解压（资源剥离用）" }
  },
  "auto_allow_methods": ["pip", "winget", "npm", "go"],
  "manual_only_methods": ["manual"]
