{
  "id": "supply-chain01",
  "domain": "supply-chain",
  "target_type": "repo (npm + GitHub Actions)",
  "protection": ["branch-protection", "dependabot", "required-review"],
  "authority": "server",
  "goal_level": "L3",
  "outcome": "planned",
  "artifacts": [],
  "evidence_dir": "evidence/supply-chain01",
  "scope": {
    "authorization": "repo owner approval; no push, no registry publish, no CI mutation",
    "objects": ["repo commit", "package-lock.json", ".github/workflows/*.yml"],
    "rate_limit_rps": 1,
    "forbidden": ["npm publish", "force-push", "edit production workflow"]
  },
  "lessons": [
    "先跑 sc-check.py --path <repo> 拿离线清单，再决定是否需要 syft/osv-scanner/cosign 联网或外部工具",
    "依赖混淆的判据是 registry 映射 + 锁文件 resolved/integrity 三者一致，不是看到 @corp/ 就下结论",
    "pull_request_target 要连同 checkout 的 ref、job 权限、secrets 作用域一起看；单独关键字命中只是线索",
    "CI action 的 tag 可移动，证据必须写 40 位 commit SHA；报告里不能只写 @v4",
    "锁文件缺失或 integrity 缺失时，不能宣称构建可复现；先给最小修复再谈 CVE"
  ],
  "tags": ["npm", "GitHub-Actions", "dependency-confusion", "lockfile", "planned"],
  "refs": [
    "Tool/skill/supply-chain-security/SKILL.md",
    "Tool/skill/supply-chain-security/references/dependency-confusion.md",
    "Tool/skill/supply-chain-security/references/cicd-and-artifacts.md",
    "Tool/mcp/Tool/reverselab/kb/supply-chain/techniques/01-dependency-confusion.md",
    "Tool/config/supply-chain-matrix.json"
  ],
  "updated": "2026-10-21"
}
