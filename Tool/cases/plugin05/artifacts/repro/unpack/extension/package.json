{
  "name": "lab-vsix-plugin",
  "displayName": "Lab VSIX Plugin",
  "version": "0.2.0",
  "publisher": "lab",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:lab.scan",
    "onLanguage:json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lab.scan",
        "title": "Lab: Scan workspace"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  }
}