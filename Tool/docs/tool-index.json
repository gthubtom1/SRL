{
  "schema": "seep.tool-index/2",
  "kind": "catalog-entry",
  "local_availability": "not_checked",
  "runtime_verified": false,
  "note": "仓库不保存某台机器的就绪快照。工具声明、发现、身份与 MCP 连接分别验证。",
  "sources": {
    "capabilities": "Tool/config/tool-capabilities.json",
    "runtimes": "Tool/config/tool-runtimes.json",
    "installation": "Tool/config/tool-install.json",
    "mcp_dependencies": "Tool/config/mcp-tool-dependencies.json"
  },
  "commands": {
    "discover": "python -X utf8 Tool/mcp/tool_autodiscover.py discover <tool-id>",
    "readiness": "python -X utf8 Tool/scripts/tool-readiness.py --json",
    "modes": "powershell -NoProfile -File Tool/scripts/tool-run.ps1 -Tool <tool-id> -ListModes"
  }
}
