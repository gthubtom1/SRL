{
  "id": "site-accept",
  "title": "站点复刻验收与后端边界标注",
  "domain": "web-pentest",
  "triggers": [
    "复刻验收",
    "PASS/PARTIAL/BLOCKED",
    "六条判据",
    "backend-required",
    "accept.json",
    "站点验收"
  ],
  "aliases": [
    "site-accept",
    "复刻验收",
    "site-acceptance"
  ],
  "version": "1.0.0",
  "inputs": [
    "site-clone 案例目录（case.json）",
    "artifacts/crawl/site-graph.json",
    "artifacts/rebuild/rebuild.json",
    "artifacts/diff.json"
  ],
  "outputs": [
    "accept.json",
    "六项 criteria 布尔与数值",
    "backend_required[]",
    "PASS/PARTIAL/BLOCKED"
  ],
  "scripts": [
    "Tool/skill/web-pentest/subskills/site-clone/scripts/site-accept.py"
  ],
  "refs": [
    "Tool/skill/web-pentest/subskills/site-clone/SKILL.md",
    "Tool/skill/web-pentest/subskills/site-clone/references/01-criteria.md",
    "Tool/skill/web-pentest/subskills/site-clone/references/07-auth-and-backend-boundary.md"
  ],
  "maturity": "probe",
  "reserved": true,
  "note": "现役入口位于 Tool/skill/web-pentest/subskills/site-clone/，随web-pentest父域递归部署到 <AgentRoot>/skills/web-pentest/subskills/site-clone/；Tool/路径相对已注册源码根。部署文件、当前宿主加载与运行依赖须分别核验。maturity=probe、reserved=true保留，表示尚未开放自动编排，不表示脚本仍未部署。只复算现有case与证据的六项判据，保留PASS/PARTIAL/BLOCKED及backend_required原义，不补造缺失证据。本次路径修正不提升历史证据或验证等级；真实凭据留在用户侧，仅使用安全输入/结果。",
  "compose": [
    "site-crawl",
    "site-rebuild",
    "visual-diff"
  ]
}
