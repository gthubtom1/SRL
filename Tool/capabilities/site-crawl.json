{
  "id": "site-crawl",
  "title": "站点爬取与路由枚举",
  "domain": "web-pentest",
  "triggers": [
    "整站抓取",
    "路由枚举",
    "crawl",
    "sitemap",
    "DOM 快照",
    "站点爬取",
    "截图"
  ],
  "aliases": [
    "site-crawl",
    "整站抓取",
    "crawler"
  ],
  "version": "1.0.0",
  "inputs": [
    "入口 URL",
    "授权 scope",
    "允许抓取的 host",
    "登录态（可选）",
    "viewport/DPR"
  ],
  "outputs": [
    "site-graph.json",
    "pages/*.html",
    "screenshots/*.png",
    "api/*",
    "routes[]/assets[]/coverage"
  ],
  "scripts": [
    "Tool/skill/web-pentest/subskills/site-clone/scripts/site-crawl.py"
  ],
  "refs": [
    "Tool/skill/web-pentest/subskills/site-clone/SKILL.md",
    "Tool/skill/web-pentest/subskills/site-clone/references/01-criteria.md",
    "Tool/config/site-clone-matrix.json"
  ],
  "maturity": "probe",
  "reserved": true,
  "note": "现役入口位于 Tool/skill/web-pentest/subskills/site-clone/，随web-pentest父域递归部署到 <AgentRoot>/skills/web-pentest/subskills/site-clone/；Tool/路径相对已注册源码根。部署文件、当前宿主加载与运行依赖须分别核验。maturity=probe、reserved=true保留，表示尚未开放自动编排，不表示脚本仍未部署。实际爬取先核scope、浏览器及截图依赖；HTTP回退与文件产出不能替代真实截图、路由覆盖及任务验收。本次路径修正不提升历史证据或验证等级；真实凭据留在用户侧，仅使用安全输入/结果。",
  "compose": [
    "site-rebuild",
    "visual-diff"
  ]
}
