{
  "id": "site-crawl",
  "title": "站点爬取与路由枚举",
  "domain": "site-clone",
  "triggers": [
    "整站抓取",
    "路由枚举",
    "crawl",
    "sitemap",
    "DOM 快照",
    "站点爬取",
    "截图"
  ],
  "aliases": [
    "site-crawl",
    "整站抓取",
    "crawler"
  ],
  "version": "1.0.0",
  "inputs": [
    "入口 URL",
    "授权 scope",
    "允许抓取的 host",
    "登录态（可选）",
    "viewport/DPR"
  ],
  "outputs": [
    "site-graph.json",
    "pages/*.html",
    "screenshots/*.png",
    "api/*",
    "routes[]/assets[]/coverage"
  ],
  "scripts": [
    "Tool/skill/_pending/site-clone/scripts/site-crawl.py"
  ],
  "refs": [
    "Tool/skill/_pending/site-clone/SKILL.md",
    "Tool/skill/_pending/site-clone/references/01-criteria.md",
    "Tool/config/site-clone-matrix.json"
  ],
  "maturity": "usable",
  "compose": [
    "site-rebuild",
    "visual-diff"
  ]
}
