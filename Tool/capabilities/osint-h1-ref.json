  "domain": "web-pentest",
  "triggers": [
    "公开报告",
    "已披露报告",
    "同类漏洞",
    "打法参照",
    "hackerone",
    "hacktivity",
    "漏洞赏金",
    "历史披露",
    "参考报告"
  ],
  "aliases": [
    "osint-h1-ref",
    "h1-ref",
    "公开报告检索",
    "h1 参考"
  ],
  "version": "1.0.0",
