{
  "mcpServers": {
    "seep": {
      "command": "python",
      "args": [
        "<SEEP_ROOT>/Tool/mcp/seep_mcp_server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "transport": "stdio"
    },
    "ida": {
      "command": "python",
      "args": [
        "<SEEP_ROOT>/Tool/scripts/mcp-launch.py", "--server", "ida"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "transport": "stdio",
      "requestTimeoutMs": 180000
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "transport": "stdio",
      "lifecycle": "lazy"
    },
    "js-reverse": {
      "command": "npx",
      "args": [
        "-y",
        "js-reverse-mcp"
      ],
      "transport": "stdio",
      "lifecycle": "lazy"
    },
    "x64dbg": {
      "command": "python",
      "args": ["<SEEP_ROOT>/Tool/scripts/mcp-launch.py", "--server", "x64dbg"],
      "transport": "stdio"
    }
  },
  "_comment": "展示模板：<SEEP_ROOT> 需要替换。AI 安装应调用 setup/merge_agent_config.py --root <仓库根> --agent-dir <选定Agent目录>，从 Tool/config/mcp-servers.json 增量生成并保留用户配置。",
  "_comment_optional": "IDA/x64dbg 需要对应软件和插件；条目存在不代表已握手。依赖来源见 Tool/docs/DOWNLOADS.md。"
}
